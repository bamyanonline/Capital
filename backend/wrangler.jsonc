{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capital-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://capitalism.pages.dev",
    "PUBLIC_BASE_URL": "https://capitalism.pages.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capital-db",
      "database_id": "6a8e33b0-1a29-4ca3-b8d0-bc9956148e4c",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["30 19 * * *"]
  }
}
