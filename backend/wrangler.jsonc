{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capital-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capital-prod-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["30 19 * * *"]
  }
}
