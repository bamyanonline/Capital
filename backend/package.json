{
  "name": "capital-cloudflare-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check worker.js",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply capital-db --local",
    "migrate:remote": "wrangler d1 migrations apply capital-db --remote",
    "verify": "npm test && npm run check"
  },
  "devDependencies": {
    "wrangler": "^4.30.0"
  }
}
